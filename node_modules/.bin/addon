#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/@plone+scripts@3.10.7/node_modules/@plone/scripts/addon/node_modules:/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/@plone+scripts@3.10.7/node_modules/@plone/scripts/node_modules:/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/@plone+scripts@3.10.7/node_modules/@plone/node_modules:/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/@plone+scripts@3.10.7/node_modules:/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/@plone+scripts@3.10.7/node_modules/@plone/scripts/addon/node_modules:/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/@plone+scripts@3.10.7/node_modules/@plone/scripts/node_modules:/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/@plone+scripts@3.10.7/node_modules/@plone/node_modules:/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/@plone+scripts@3.10.7/node_modules:/Users/rnunez/devel/yc1/frontend/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@plone/scripts/addon/index.js" "$@"
else
  exec node  "$basedir/../@plone/scripts/addon/index.js" "$@"
fi
